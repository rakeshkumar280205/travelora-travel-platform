generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  CONSULTANT
}

enum PackageStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CONSULTANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Package {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  destination        String
  durationDays       Int
  description        String
  category           String
  hotelCategory      String
  status             PackageStatus    @default(DRAFT)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  seasonalPrices     SeasonalPrice[]
  itineraryDays      ItineraryDay[]
  publishedVersionId String?          @unique
  versions           PackageVersion[] @relation("PackageVersions")
  publishedVersion   PackageVersion?  @relation("PublishedPackageVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
}

model SeasonalPrice {
  id           String   @id @default(cuid())
  packageId    String
  seasonName   String
  startDate    DateTime
  endDate      DateTime
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("INR")
  pricingBasis String
  package      Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model ItineraryDay {
  id          String  @id @default(cuid())
  packageId   String
  dayNumber   Int
  title       String
  description String
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, dayNumber])
  @@index([packageId])
}

model PackageVersion {
  id            String   @id @default(cuid())
  packageId     String
  versionNumber Int
  snapshot      Json
  createdBy     String?
  createdAt     DateTime @default(now())

  package      Package  @relation("PackageVersions", fields: [packageId], references: [id], onDelete: Cascade)
  publishedFor Package? @relation("PublishedPackageVersion")

  @@unique([packageId, versionNumber])
  @@index([packageId, createdAt])
}
