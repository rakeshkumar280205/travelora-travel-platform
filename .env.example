# Neon PostgreSQL database connections
# DATABASE_URL: Pooled connection string (with PgBouncer) used by Prisma Client at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection string used by Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-sample.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="replace-with-a-random-value-at-least-32-characters"
NEXTAUTH_SECRET="replace-with-the-same-value-as-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Development/test seed only. Never commit real credentials.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-development-password"

# Optional future integration.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
NEXT_PUBLIC_APP_URL=""
# Used for absolute canonical URLs, sitemap.xml and robots.txt.

# Optional production distributed rate limiting (Upstash Redis).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_PUBLIC_ENQUIRY_MAX="5"
RATE_LIMIT_PUBLIC_ENQUIRY_WINDOW="1 h"
RATE_LIMIT_AI_MAX="10"
RATE_LIMIT_AI_WINDOW="1 m"
